# MongoDB Atlas connection string
# Get this from Atlas -> Database -> Connect -> Drivers
# Replace <username>, <password>, and the cluster host with your real values
# Keep the database name (lifeos) at the end of the path, before the query string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/lifeos?retryWrites=true&w=majority

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

PORT=5000

# Enables the per-task AI chatbot (Health, Finance, Study, etc.).
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
